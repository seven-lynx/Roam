# Allowlist for scripts/check-rules.mjs
#
# Format: <RULE_ID>: <glob-pattern>
#
# Glob patterns supported:
#   path/relative/to/repo.ts       — exact path match
#   path/to/dir/**                  — matches anything under that dir
#   **/filename.ts                  — matches anywhere with that filename
#
# R2 = attribution patterns; R3 = hardcoded secret; R8 = empty catch;
# R9 = `as any` cast. Each rule's message in scripts/check-rules.mjs names what
# it checks and what to do about it; use this file only to waive a specific file.

# ── Self-allowlist ──────────────────────────────────────────────────────────
# The rules script must mention the rule IDs it enforces.
R2: scripts/check-rules.mjs

# The vitest test file for the rules script intentionally contains example
# violations (hardcoded secrets, `as any`, empty catches) so the script can
# detect them. The test runs in a tempdir; the real repo is scanned normally.
R2: extension/src/__tests__/check-rules.test.ts
R3: extension/src/__tests__/check-rules.test.ts
R8: extension/src/__tests__/check-rules.test.ts
R9: extension/src/__tests__/check-rules.test.ts

