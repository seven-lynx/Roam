# Dependencies
node_modules/
.pnpm-store/

# Environment
.env
.env.local
.env.*.local

# Build output
.next/
out/
dist/
build/
*.tsbuildinfo

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Personal workspace files (local-only AI tooling notes; not part of the repo rules)
CLAUDE.md
web/CLAUDE.md
.github/copilot-instructions.md
.github/skills/
# NOTE: web/AGENTS.md is intentionally tracked — it's the canonical rules file
# for the web layer, distinct from any personal AI tooling notes.

# gh CLI temp files
gh_runs.json

# Android release keystore
android/roam-release.jks

# Reports
scripts/reports/offline/
scripts/reports/.checkpoints/

# Cache / generated data (large files)
scripts/.cache/

# Storage (Apify/playwright)
storage/

# Firebase service account keys
*-firebase-adminsdk-*.json

# Supabase
supabase/.temp/

# Embedded repos in scripts
scripts/.cache/stumbleupon-awesome/

# Misc
*.log

# Local / internal workspace (excluded from the public repo)
# Roam uses a single public repo. Internal docs, seeders, AI files, and
# secrets are kept OUT of version control - see CLAUDE.md "Repository layout".
.roam-local/
# Only the public reference docs under docs/ are tracked; everything else
# (audit reports, incident retros, email digests) stays local-only.
docs/*
!docs/ALGORITHM.md
!docs/API.md
!docs/BADGE_SYSTEM_ARCHITECTURE.md
!docs/ROADMAP.md
!docs/STORE_SUBMISSION_GUIDE.md
# Only the CI rule-enforcement scripts are tracked; seeders and offline
# tooling under scripts/ stay local-only.
scripts/*
!scripts/check-rules.mjs
!scripts/validate-env.mjs
!scripts/verify-roam-rpc.mjs
!scripts/.rules-allowlist
# Backend tooling under supabase/scripts is tracked (unlike the local-only
# root scripts/ directory used for offline seeders and AI tooling).
!supabase/scripts/
.vscode/mcp.json
android/app/google-services.json
sync-public.ps1
