# Dependencies
node_modules/
.pnpm-store/
package-lock.json   # npm lockfile — project uses pnpm (pnpm-lock.yaml)

# Environment
.env
.env.local
.env.*.local

# Build output
.next/
out/
dist/
dist-firefox/
build/
*.tsbuildinfo

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# gh CLI temp files
gh_runs.json

# Android release keystore
android/roam-release.jks

# Reports
scripts/reports/offline/
scripts/reports/.checkpoints/
# Visual recording output (large screenshots/videos)
artifacts/
# Full-resolution capture masters (photographic, ~7 MB for the set). The
# committed derivatives under web/public/walkthrough/ and res/drawable-nodpi/
# are downscaled from these — see docs/VISUAL-RECORDING.md.
assets/Screenshots/

# Cache / generated data (large files)
scripts/.cache/

# Storage (Apify/playwright)
storage/

# Firebase service account keys
*-firebase-adminsdk-*.json

# Supabase
supabase/.temp/

# Embedded repos in scripts
scripts/.cache/stumbleupon-awesome/

# Misc
*.log

# Skyhook overlay tool runtime (logs, local state)
.skyhook/

# Local / internal workspace (excluded from the public repo)
# Roam uses a single public repo. Internal docs, seeders, and secrets are
# kept out of version control.
.roam-local/
# Only the CI rule-enforcement scripts are tracked; seeders and offline
# tooling under scripts/ stay local-only.
scripts/*
!scripts/check-rules.mjs
!scripts/validate-env.mjs
!scripts/verify-roam-rpc.mjs
!scripts/record-android.mjs
!scripts/sentry-reconcile.mjs
!scripts/.rules-allowlist
# Backend tooling under supabase/scripts is tracked (unlike the local-only
# root scripts/ directory used for offline seeders).
!supabase/scripts/
android/app/google-services.json

# Local working notes
web/*.local.md
