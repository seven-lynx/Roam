* text=auto eol=lf
*.bat text eol=crlf

# Binary assets must never be line-ending normalized or re-encoded.
# (A repo migration in Oct 2026 re-encoded these as UTF-8 text, corrupting them.)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.jar   binary
*.apk   binary
*.aab   binary
*.bin   binary

# The cyberdeck control contact sheet is generated by web/scripts/slice-controls.mjs
# and inlines every control PNG (~2.9 MB). It stays in the repo so the controls can be
# named, but is excluded from language stats so HTML does not outvote TypeScript.
web/public/cyberdeck/controls/contact-sheet.html linguist-generated