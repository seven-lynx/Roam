{
  "name": "roam",
  "seedersDir": "scripts",
  "dataDir": "scripts/.cache",
  "logDir": "scripts/.cache/logs",
  "stagedDir": "scripts/.cache/staged",

  "pipeline": {
    "offlineDb": "scripts/reports/offline/roam.db",
    "knownUrlsDb": "scripts/.cache/known-urls.db",
    "jobs": {
      "export": {
        "label": "Pull DB",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "pull"]
      },
      "export-full": {
        "label": "Pull all (force)",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "pull", "--force"],
        "danger": true
      },
      "import-staged": {
        "label": "Import staged -> offline DB",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "import-staged"]
      },
      "tag": {
        "label": "Start tagger",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "tag"]
      },
      "retag-add": {
        "label": "Second pass (add tags)",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "tag", "--mode", "retag-add"]
      },
      "retag-replace": {
        "label": "Second pass (replace)",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "tag", "--mode", "retag-replace"],
        "danger": true
      },
      "push": {
        "label": "Push to DB",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "upload"]
      },
      "index": {
        "label": "Sync known-URLs index",
        "command": ["scripts/node_modules/skyhook/bin/skyhook.js", "pull", "--index-only"]
      }
    }
  }
}
