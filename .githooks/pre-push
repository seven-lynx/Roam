#!/bin/sh
# Reject pushes of branches whose name does not follow <type>/<kebab>
# (RULES.md Process Rule 2.1, enforced in CI by scripts/check-rules.mjs R11).
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass for a one-off (not recommended): git push --no-verify
#
# core.hooksPath lives in .git/config, which git worktrees share — so this also
# guards branches pushed from a worktree or a sandbox checkout.

allowed='^(feature|feat|fix|chore|docs|test|refactor|perf|audit|build|ci|release)/[a-z0-9][a-z0-9._-]*$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_ref" = "(delete)" ] && continue
  case "$local_ref" in
    refs/heads/*) branch=${local_ref#refs/heads/} ;;
    *) continue ;;
  esac
  case "$branch" in
    main|develop) continue ;;
  esac
  if ! printf '%s' "$branch" | grep -Eq "$allowed"; then
    echo "push rejected: branch '$branch' does not match <type>/<kebab>" >&2
    echo "  allowed types: feature feat fix chore docs test refactor perf audit build ci release" >&2
    echo "  rename it:     git branch -m <type>/<kebab>" >&2
    echo "  see RULES.md 2.1" >&2
    status=1
  fi
done

exit $status