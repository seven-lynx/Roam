# Web (.env.local) — Next.js public env vars + Sentry source-map upload
# This file is gitignored. Copy .env.example to .env.local and fill in.

# ─── Supabase (safe to expose; public anon key) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sentry (browser DSN is public) ─────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx

# ─── Sentry auth token (server-only, for source-map upload on Vercel) ───────
# NOT exposed to the browser. Vercel-only.
SENTRY_AUTH_TOKEN=sntryu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Web push (VAPID) ───────────────────────────────────────────────────────
# Generated once via web-push generate-vapid-keys.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ─── Service role (admin server actions only; never expose) ─────────────────
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email unsubscribe token ────────────────────────────────────────────────
# Used by /api/unsubscribe to sign tokens.
UNSUBSCRIBE_SECRET=replace-with-random-32-bytes-base64