{
  "manifest_version": 3,
  "name": "Roam",
  "version": "0.1.0",
  "description": "Discover the web again. Click Roam to jump to something interesting.",

  "browser_specific_settings": {
    "gecko": {
      "id": "roam@roamtheweb.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },

  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Roam"
  },

  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },

  "permissions": [
    "tabs",
    "storage"
  ],

  "host_permissions": [
    "https://*.supabase.co/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["callback.html"],
      "matches": []
    }
  ]
}
