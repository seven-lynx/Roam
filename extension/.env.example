# Extension build-time env vars (read by extension/build.mjs via esbuild `define`)
# This file is gitignored. Copy .env.example to .env and fill in.
# See extension/AGENTS.md § E.1 for the build pipeline.

# ─── Supabase (anon key is public; safe to bundle) ──────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Sentry (DSN is public; safe to bundle) ─────────────────────────────────
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxx@xxxx.ingest.sentry.io/xxxx

# ─── Build identity ─────────────────────────────────────────────────────────
# Used for Sentry release tagging. Auto-derived from package.json version
# + git SHA by build.mjs; override only if needed.
# __SENTRY_RELEASE__=
# __ENVIRONMENT__=production

# ─── Safe Browsing (optional) ───────────────────────────────────────────────
# Used by supabase/functions/_shared/safe-browsing.ts.
SAFE_BROWSING_API_KEY=