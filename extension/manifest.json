{
  "manifest_version": 3,
  "name": "Roam",
  "version": "0.4.0",
  "description": "Discover the web again. Click Roam to jump to something interesting.",

  "icons": {
    "16":  "icon-16.png",
    "32":  "icon-32.png",
    "48":  "icon-48.png",
    "128": "icon-128.png"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon-16.png",
      "32":  "icon-32.png",
      "48":  "icon-48.png",
      "128": "icon-128.png"
    },
    "default_title": "Roam"
  },

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "commands": {
    "roam": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "MacCtrl+Shift+R"
      },
      "description": "Roam to a new page"
    }
  },

  "permissions": [
    "tabs",
    "storage",
    "identity"
  ],

  "host_permissions": [
    "https://*.supabase.co/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },

  "web_accessible_resources": [
    {
      "resources": ["callback.html"],
      "matches": ["https://*.supabase.co/*"]
    }
  ]
}
