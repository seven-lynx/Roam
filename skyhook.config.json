{
  "name": "roam",
  "userAgent": "Roam-Seeder/1.0 (+https://roamtheweb.app)",
  "seedersDir": "scripts",
  "dataDir": "scripts/.cache",
  "categoriesFile": "scripts/skyhook/categories.json",
  "manifestFile": "scripts/seeders-manifest.json",
  "descriptionsFile": "scripts/seeders-descriptions.json",
  "stateDb": "scripts/.cache/seeder-state.db",
  "logDir": "scripts/.cache/logs",
  "stagedDir": "scripts/.cache/staged",
  "storage": {
    "provider": "supabase",
    "schemaFile": "scripts/skyhook/schema.json"
  },
  "pipeline": {
    "status": "scripts/pipeline-status.mjs",
    "jobs": {
      "export": {
        "label": "Update export",
        "command": ["scripts/export-untagged-urls.mjs"]
      },
      "export-full": {
        "label": "Full rebuild",
        "command": ["scripts/reports/export-db.mjs"],
        "danger": true
      },
      "tag": {
        "label": "Start tagging",
        "command": ["scripts/run-full-pipeline.mjs", "--tag"]
      },
      "push": {
        "label": "Push to database",
        "command": ["scripts/run-full-pipeline.mjs", "--push"]
      }
    }
  }
}
